# Copy to .env and adjust. Code reads every path from here or from configs/ (spec §4.2).
HA_ROOT=D:\humanalign-rag
HA_DATA=D:\humanalign-rag\data
HA_CACHE=D:\humanalign-rag\cache
# Seal scopes (plan I-4): 0 = all sealed; comma list of cal_test,heldout_A,heldout_systems; 1 = all open.
HA_UNSEAL=0

# Model caches (already on D:; reused, see decisions D-011)
HF_HOME=D:\ai-models\huggingface
TORCH_HOME=D:\ai-models\torch
# OLLAMA_MODELS must be a Windows user env var before Ollama starts; recorded here for reference.
OLLAMA_MODELS=D:\ai-models\ollama
OLLAMA_HOST=http://127.0.0.1:11434

# Temp files for this project stay off C: (D-019). ha.paths sets TEMP/TMP to this for every
# Python process; shell commands that install or build set $env:TEMP to it explicitly.
HA_TMP=D:\humanalign-rag\cache\tmp

# Must also be set as a user env var so the interpreter starts in UTF-8 mode.
PYTHONUTF8=1
